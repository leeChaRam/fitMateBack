spring.application.name=fit_mate_server

# 1. DB 연결 정보
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
# localhost:3306 뒤에 아까 만든 방 이름(inbody_db)을 적어줍니다.
spring.datasource.url=jdbc:mariadb://localhost:3306/inbody_db?serverTimezone=Asia/Seoul
spring.datasource.username=root
# 여기에 아까 설정하신 비밀번호(예: 1234)를 입력하세요.
spring.datasource.password= your_password_here

# 2. JPA 설정 (Java 객체를 DB 테이블로 자동 변환)
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# MariaDB 호환성을 위한 방언 설정
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect

jwt.secret=비밀키 넣어야함 
jwt.expiration-ms=3600000

## 초기 설정
   cp src/main/resources/application.properties.sample src/main/resources/application.properties
   그 다음 <DB_HOST>, <DB_USERNAME>, <DB_PASSWORD>, <JWT_SECRET_KEY> 부분을 실제 값으로 채워주세요.

   